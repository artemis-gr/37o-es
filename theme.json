{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "layout": { "contentSize": "980px", "wideSize": "1100px" },
    "custom": { "editor": { "contentPadding": "24px" } },
    "spacing": { "units": ["px", "rem", "em", "%", "vw", "vh"] },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontSizes": [
        { "slug": "proj-small",  "size": "1rem",  "name": "Small Text"  },
        { "slug": "proj-normal", "size": "1.2rem","name": "Medium Text" }
      ]
    }
  },
  "styles": {
  "layout": { "contentSize": "980px", "wideSize": "1100px" },
  "spacing": { "blockGap": "0" },                 
  "typography": {
    "fontFamily": "'Cormorant Garamond', GeorgiaCustom, Georgia, serif",
    "textColor": "#373737"
  }
}
}

